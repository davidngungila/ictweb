APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ictweb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Snippe (payments) — required for /payment ─────────────────────────────
# From Snippe dashboard; without this, checkout will not work.
SNIPPE_API_KEY=
# Used to verify webhook signatures (set to the secret Snippe gives you for webhooks).
SNIPPE_WEBHOOK_SECRET=
# Optional; only change if Snippe gives you a different API host.
SNIPPE_API_BASE_URL=https://api.snippe.sh
# Where the customer is sent after paying (your public thank-you page).
SNIPPE_POST_PAYMENT_REDIRECT_URL="https://jezdantech.com/thank-you"
# Public HTTPS URL on THIS app that receives Snippe webhooks (POST), e.g. production:
# SNIPPE_WEBHOOK_URL="https://jezdantech.com/webhook/snippe"
# Local / no tunnel: leave empty or use an ngrok URL Snippe can reach.
SNIPPE_WEBHOOK_URL=
# After changing these: php artisan config:clear
